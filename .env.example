# Clave de API principal de Google Gemini (gratis en https://aistudio.google.com/)
GEMINI_API_KEY=tu_api_key_aqui

# Clave de respaldo opcional (de otra cuenta) por si la principal agota su cuota durante la demo
GEMINI_API_KEY_BACKUP=

# Modelo generativo (opcional)
GEMINI_MODEL=gemini-3.5-flash-lite

# Embeddings semánticos para la búsqueda (opcional)
EMBEDDING_MODEL=gemini-embedding-001
USE_GEMINI_EMBEDDINGS=true
